.env
*.log
.DS_Store
node_modules/
/vendor/
/.phpunit.cache/
composer.phar
storage/kyc/*
!storage/kyc/.gitkeep
storage/benchmarks/*
!storage/benchmarks/.gitkeep
# Generated report exports hold real message content (recipients, message bodies).
# They are transient artifacts with a retention window — never commit them.
storage/exports/*
!storage/exports/.gitkeep
storage/imports/*
!storage/imports/.gitkeep
# Vesal table exports for cron/aimed-mobiles-import.php: subscriber numbers, never committed.
storage/aimed-import/
public/assets/img/slides/*
!public/assets/img/slides/.gitkeep

# Claude Code local-only
.claude/settings.local.json
.claude/worktrees/

# Python bytecode (sdk/python)
__pycache__/
*.pyc
smpp-bridge/target/

# Runtime state the containers write into the bind-mounted checkout — never commit it.
# Backups hold the whole database; rclone.conf holds the off-server storage credentials.
storage/backups/
storage/rclone/
storage/*.key
storage/logs/*
!storage/logs/.gitkeep
storage/maintenance.flag
storage/dr-drill-status.json

# taste-skill working files (direction sheet, inspector screenshots)
.taste-skill/
