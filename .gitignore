.env
*.log
.DS_Store
node_modules/
/vendor/
/.phpunit.cache/
composer.phar
storage/kyc/*
!storage/kyc/.gitkeep
storage/benchmarks/*
!storage/benchmarks/.gitkeep
# Generated report exports hold real message content (recipients, message bodies).
# They are transient artifacts with a retention window — never commit them.
storage/exports/*
!storage/exports/.gitkeep
storage/imports/*
!storage/imports/.gitkeep
public/assets/img/slides/*
!public/assets/img/slides/.gitkeep

# Claude Code local-only
.claude/settings.local.json
.claude/worktrees/
