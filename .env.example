# Copy this file to .env and adjust before `docker compose up`.
# ELLSMS shares negar-python's MySQL database — these values must match
# what's in negar-python's own .env (DATABASE__* keys there).
APP_PORT=8080

NEGAR_DB_HOST=negar-mysql
NEGAR_DB_PORT=3306
NEGAR_DB_NAME=negar
NEGAR_DB_USER=dbtest
NEGAR_DB_PASS=change_me_match_negar_python_env

# Vesal/Armaghan gateway — same values as negar-python's
# OPERATOR_LINK__VESAL_* .env keys. Can also be edited later from
# Settings in the panel (stored in ellsms_settings, which then wins).
VESAL_REST_URL=http://192.168.2.27:8081/backend
VESAL_USERNAME=negar
VESAL_PASSWORD=
