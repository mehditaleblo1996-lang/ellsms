# Copy this file to .env and fill in real values before `docker compose up`.
# NEVER commit the real .env — it's already in .gitignore. Never paste real
# credentials into THIS file (.env.example); it must contain placeholders only.

# --- App ---
APP_PORT=8080
# production | local | staging — shown in logs, /health, and the panel
# footer for at-a-glance environment identification. Also a hard gate on
# APP_DEBUG below: whenever this is "production", debug output is FORCED
# off no matter what APP_DEBUG says — not just a convention to follow.
APP_ENV=production
# 1 = show real PHP errors/stack traces in the browser (local/dev only).
# 0 = errors are only logged server-side, never shown to the browser.
# Has no effect at all while APP_ENV=production (see above) — the app
# must never use debug output in production, even if this is set to 1
# by mistake.
APP_DEBUG=0
# Canonical public base URL of this ELLSMS deployment, no trailing slash
# (e.g. https://sms.example.com). Used as a safer fallback than the
# request's Host header when deriving callback URLs (see
# ZARINPAL_CALLBACK_URL below) if that's left unset. Leave blank to fall
# back further to request-derived URLs — fine for local/dev, not
# recommended for production.
APP_URL=
# Deployed build identifier — shown in logs, /health, and the panel
# footer. Leave blank to use the baked-in ELLSMS_VERSION constant
# (app/bootstrap.php); CI/CD can instead inject a git SHA or release tag
# here without any source change, e.g. APP_VERSION=$(git rev-parse --short HEAD).
APP_VERSION=

# --- Trusted proxy (Phase 10) ---
# Comma-separated IP/CIDR allowlist of reverse proxies whose X-Forwarded-For/X-Forwarded-Proto
# headers are trusted (e.g. "10.0.0.0/8" or "172.20.0.5,172.20.0.6"). Leave BLANK (the safe
# default) to trust NOTHING — X-Forwarded-* is ignored entirely and the app uses only the direct
# connection's own IP/scheme, which is safe but means HTTPS detection and rate-limit IP resolution
# will use the reverse proxy's OWN address, not the real client's, if this deployment actually runs
# behind one. If you put a reverse proxy in front of ELLSMS (the standard production topology —
# see README Production notes), you almost certainly want to set this to that proxy's address.
# NEVER set this to a wildcard/0.0.0.0/0 — that reopens the exact spoofing this setting exists to
# close. See docs/production-hardening.md.
TRUSTED_PROXY_IPS=

# --- Session security (Phase 2) ---
# Seconds of inactivity before a logged-in session is forced to
# re-authenticate. Resets on every request (rolling window).
SESSION_IDLE_TIMEOUT_SECONDS=1800
# Seconds since login before a session is forced to re-authenticate
# regardless of activity.
SESSION_ABSOLUTE_TIMEOUT_SECONDS=43200

# --- Rate limiting (Phase 2, app/rate_limit.php — no Redis, DB-backed) ---
# Each pair is "max attempts" / "trailing window in seconds", checked per
# IP and per account identifier separately (see app/rate_limit.php).
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_2FA_VERIFY_MAX=10
RATE_LIMIT_2FA_VERIFY_WINDOW_SECONDS=900
RATE_LIMIT_2FA_RESEND_MAX=5
RATE_LIMIT_2FA_RESEND_WINDOW_SECONDS=3600
# The legacy URL send API (public/sms/url_send.html) — higher ceiling
# since this is meant for legitimate automated integrations, not a login form.
RATE_LIMIT_API_SEND_MAX=30
RATE_LIMIT_API_SEND_WINDOW_SECONDS=300

# --- Shared database (must match the connected backend's own DB config) ---
# The Docker network name the backend platform's own docker-compose.yml
# created (find it with `docker network ls` if you're not sure).
BACKEND_NETWORK=change_me
# The container/hostname MySQL is reachable at on that network.
BACKEND_DB_HOST=change_me
BACKEND_DB_PORT=3306
BACKEND_DB_NAME=change_me
BACKEND_DB_USER=change_me
BACKEND_DB_PASS=change_me

# --- Worker (cron/worker.php) ---
# How often (seconds) the worker container polls for due scheduled
# sends, new inbound messages to auto-reply to, and queued bulk-send
# rows. Lower = more responsive, more DB load; higher = the opposite.
WORKER_POLL_INTERVAL_SECONDS=8

# --- Job queue reliability (Phase 4, docs/job-queue-architecture.md) ---
# How long a worker's claim on a bulk item / schedule / auto-reply row is
# valid before another worker may treat it as abandoned and reclaim it
# (crash recovery). Must comfortably exceed the slowest realistic single
# item's gateway round-trip, or a still-working claim could be reclaimed
# out from under an active worker.
WORKER_JOB_LEASE_SECONDS=300
# How many times a worker will retry a retryable failure (network/HTTP
# error reaching the gateway) before treating it as a permanent, terminal
# failure. A permanent failure (invalid destination, unauthorized
# originator, revoked access, insufficient credit) is never retried
# regardless of this value.
JOB_MAX_ATTEMPTS=5
# Bounded exponential backoff between retries: base * 2^(attempt-1),
# capped at JOB_RETRY_MAX_SECONDS. With the defaults below and
# JOB_MAX_ATTEMPTS=5: 30s, 1m, 2m, 4m, 8m.
JOB_RETRY_BASE_SECONDS=30
JOB_RETRY_MAX_SECONDS=1800

# --- Sending / backend messaging API ---
# Base URL of the backend's own REST API. ELLSMS POSTs to
# {API_BASE_URL}/api/messages/send to actually send a message, and to
# {API_BASE_URL}/api/users/ to create accounts. Can also be set later
# from Settings in the panel (stored in ellsms_settings, which then wins
# over this default).
API_BASE_URL=

# --- Backend service-to-service authentication (Phase 2, STEP 12) ---
# Optional and OFF by default (both blank = no signing headers sent,
# identical to pre-Phase-2 behavior). If both are set, every request to
# the backend API is HMAC-signed — see backend_service_auth_headers() in
# app/backend.php for the exact header contract the backend platform
# would need to verify. Client-side only: this does not become real
# end-to-end authentication until the backend side also verifies it.
BACKEND_SERVICE_ID=
BACKEND_SERVICE_SECRET=

# --- Payments (ZarinPal) ---
# Can also be set later from Settings in the panel (stored in
# ellsms_settings, which then wins over these defaults).
# Get your Merchant ID from https://next.zarinpal.com after registering.
ZARINPAL_MERCHANT_ID=
# Must match what ZarinPal calls back to after a payment attempt. Leave
# blank to fall back to APP_URL (above), then to auto-deriving from the
# current request's Host header — fine for testing, but ZarinPal merchant
# accounts are typically tied to a specific registered domain, and a Host
# header is client-supplied, so set this explicitly for production.
ZARINPAL_CALLBACK_URL=https://your-domain/zarinpal-callback.php
# Set to 1 to use ZarinPal's sandbox (test) environment — no real money
# moves, useful before your merchant account is fully approved.
ZARINPAL_SANDBOX=0

# --- Public API & webhooks (Phase 12, docs/public-api.md, docs/webhooks.md) ---
# OFF by default -- an existing install stays exactly as it was until an operator deliberately
# opts in. When 0, every /api/v1/* route responds 503 without touching the database at all.
API_ENABLED=0
# Requests per minute allowed per API key (a burst window and a per-organization aggregate ceiling
# are also enforced -- see app/Api/RateLimit.php; these two are the only operator-tunable knobs).
API_RATE_LIMIT_PER_MINUTE=60
API_RATE_LIMIT_BURST=15
# Hard cap on a JSON request body, checked BEFORE parsing (both Content-Length and the actual bytes
# read are checked -- a lying Content-Length header does not bypass this).
API_MAX_BODY_BYTES=262144
# Hard cap on items in a single POST /api/v1/bulk-jobs request.
API_MAX_BULK_ITEMS=5000
# How long a COMPLETED Idempotency-Key record is kept before cron/idempotency-prune.php may delete
# it. An in_progress record is never pruned by age here -- see app/Idempotency.php.
API_IDEMPOTENCY_TTL_HOURS=48
# 32 raw bytes, base64-encoded (e.g. `openssl rand -base64 32`) -- encrypts webhook endpoint signing
# secrets at rest (AES-256-GCM) so they can be decrypted again at delivery time. REQUIRED once
# API_ENABLED=1 and any webhook endpoint is created; cron/config-check.php fails closed without it.
# NEVER reuse BACKEND_SERVICE_SECRET or any API key material for this (Invariant L) -- generate a
# fresh, independent value.
WEBHOOK_MASTER_KEY=
# Per-attempt HTTP timeout / max attempts before a delivery dead-letters / max response bytes kept
# (bounded, sanitized -- never the full response body) / require HTTPS for webhook endpoint URLs
# (STEP 29 -- disabling this in production is a config-check FAIL).
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_MAX_RESPONSE_BYTES=4096
WEBHOOK_REQUIRE_HTTPS=1
# Test-only SSRF bypass (see app/Webhooks.php's webhook_local_targets_allowed() docblock) --
# NEVER set this in production; cron/config-check.php FAILs if it's ever on with APP_ENV=production.
# Leave unset/0 always, except when running Phase 12's real webhook-delivery integration tests.
WEBHOOK_ALLOW_PRIVATE_TARGETS=0

# --- Plans, subscriptions & quotas (Phase 13, docs/plans-and-entitlements.md) ---
# OFF by default. When 0, EVERY entitlement check passes, every limit is unlimited, and the quota
# subsystem does not write a single row — an existing install behaves exactly as it did before
# Phase 13 until an operator deliberately opts in. Enable only AFTER running `make billing-backfill`
# and confirming `make subscription-integrity-check` shows every organization on its intended plan
# (see docs/billing-operations.md — enabling before backfilling is the one genuinely risky order).
BILLING_ENABLED=0
# Plan code a brand-new organization is placed on once billing is enabled. Must match a row in
# ellsms_plans (config-check verifies this).
DEFAULT_PLAN_CODE=free
# Days a past_due subscription keeps working before it is suspended. Never infinite; 0 means a
# past_due subscription is suspended on the very next lifecycle pass.
SUBSCRIPTION_GRACE_DAYS=7
# Max subscriptions/reservations one cron/subscription-lifecycle.php pass will process, so a single
# run can never grow unboundedly long on a large install.
SUBSCRIPTION_JOB_BATCH_SIZE=200
# How long an unfinished usage reservation is held before the lifecycle scheduler releases it back
# (a crashed request, an abandoned idempotent call). A COMMITTED reservation is never released.
USAGE_RESERVATION_TTL_MINUTES=60
# Currency code recorded on plans and billing records. Amounts are stored in the smallest unit
# (Rial), the same convention ellsms_payments.amount_rial already uses.
BILLING_CURRENCY=IRR

# --- Pre-send cost preview (docs/cost-preview.md) ---
# All three are optional with safe defaults; none changes existing send behavior. A cost preview is
# always read-only — it reserves no credit, consumes no quota, and creates no message.
# How long a web preview stays valid before the confirm step asks the user to re-check the cost.
COST_PREVIEW_TTL_SECONDS=300
# Cost drift (percent) between preview and confirmation that forces re-confirmation in the web UI
# rather than silently charging a different amount. The API always proceeds on current
# authoritative values instead.
COST_PREVIEW_RECONFIRM_PERCENT=5
# Above this many resolved recipients, personalized bulk segment counting switches from exact
# per-recipient counting to a sampled estimate, and the result is explicitly labelled inexact.
COST_PREVIEW_EXACT_RECIPIENT_LIMIT=20000

# --- SMS pricing (docs/sms-pricing.md) ---
# There is deliberately NO master switch and no per-price environment variable here: operators,
# prefixes, providers, routes and tariffs are ADMIN-MANAGED DATABASE CONFIGURATION, edited from
# Platform Admin -> تعرفه‌ی پیامک, not deployment config. An install that has applied the migration
# prices exactly as it did before (1 credit per SMS segment) until an admin deliberately changes it.
# The one exception is this cache window, which is genuinely about process behavior rather than
# pricing policy: how long the long-running worker may reuse a loaded catalog before re-reading it,
# so an admin's tariff change takes effect without a worker restart. 0 disables caching entirely.
SMS_PRICING_CACHE_TTL_SECONDS=30

# --- SMS gateway connectors (docs/sms-gateway-connectors.md) ---
# Gateways themselves -- endpoints, parameters, auth schemes, response mappings -- are ADMIN-MANAGED
# DATABASE CONFIGURATION, edited from Platform Admin -> درگاه‌های پیامک. What lives here is only the
# handful of things that are genuinely deployment concerns.
#
# The master switch that re-points the LIVE SMS transport. 0 (the default) keeps every send on the
# legacy REST client, so applying the migration changes nothing about how messages are sent. Turn it
# on only after `make sms-gateway-simulate TO=... COMPARE=1` reports IDENTICAL. Rollback is setting
# it back to 0 and restarting the workers -- no configuration has to be undone.
SMS_GATEWAY_TRANSPORT=0

# Root key for the gateway secret vault (AES-256-GCM via HKDF). Minimum 32 characters; a shorter one
# is refused rather than silently weakening the key. Generate with: openssl rand -base64 48
#
# NEVER back this up together with the database, and never reuse BACKEND_SERVICE_SECRET, a webhook
# secret, or any API key material for it -- the whole point of a separate key is that a leak in one
# domain does not compromise the others. Restoring a database onto a host WITHOUT this exact key
# leaves gateway secrets undecryptable; that is intended, and is why the restore procedure in
# docs/backup-and-disaster-recovery.md treats the key as a separate, manually-carried artifact.
SMS_GATEWAY_MASTER_KEY=

# How long a worker may reuse its knowledge of gateway config versions before re-checking. This is
# the MAXIMUM delay before an admin's gateway change reaches a running worker. Never re-reads the
# configuration itself -- only a one-row-per-gateway version list.
SMS_GATEWAY_VERSION_CHECK_SECONDS=30

# Rows claimed per delivery-status polling pass (cron/sms-status-poll.php).
SMS_GATEWAY_STATUS_BATCH=100

# How often the persistent status-worker container LOOKS for messages whose delivery status is due
# to be polled (cron/sms-status-worker.php, the `status-worker` compose service).
#
# This is NOT the provider polling delay. Whether a given message is due is decided entirely by its
# gateway's own status connector (poll_initial_delay_seconds, poll_max_attempts, poll_max_age_seconds)
# -- this interval only governs how often we look. Waking every 15s against a connector configured
# for a 30s initial delay simply means the row is skipped on the first look, which is why a short
# interval here is cheap rather than abusive to the provider.
#
# Minimum 5 (a lower value is raised to it and logged): a zero/sub-second interval would be a busy
# loop issuing claim queries against the database continuously.
SMS_GATEWAY_STATUS_WORKER_INTERVAL_SECONDS=15

# Maximum provider message ids in ONE batched status request. Bounds the request a connector using
# `provider_message_ids` builds, so a backlog cannot turn into a single enormous POST -- a provider
# rejecting or timing out on an oversized request would fail every message in it at once.
SMS_GATEWAY_STATUS_REQUEST_MAX=50

# Comma-separated EXACT HOSTNAMES exempt from the rule that a gateway endpoint must not resolve to a
# private/loopback/link-local address. Not a wildcard list, not a substring match, and deliberately
# not a blanket "allow private addresses" switch: `evil-sms-gw.internal` does not satisfy an entry for
# `sms-gw.internal`. An allowlisted host skips the address check and the connection pin, because
# naming it here IS the statement that it may resolve privately. Leave empty unless your provider
# genuinely is on an internal network.
SMS_GATEWAY_INTERNAL_HOSTS=

# Applies the PRODUCTION address rules outside production. Off by default so local development and
# the test fixtures can reach http://127.0.0.1; the integration tests set it to 1 so they exercise the
# real production decision path rather than a re-implementation of it.
SMS_GATEWAY_ENFORCE_ADDRESS_RULES=0

# How long a VALIDATED endpoint resolution is reused within one worker process. Resolution runs before
# every outbound request, so without this a hostname endpoint costs a resolver round trip per send.
# Caching does not weaken the rebinding protection -- what is cached is the address set that already
# PASSED validation, and the connection is pinned to it. The only cost is that a legitimate address
# change takes up to this long to be noticed.
SMS_GATEWAY_DNS_CACHE_SECONDS=30

# --- Contact form (Telegram) ---
# Can also be set later from Settings in the panel (stored in
# ellsms_settings, which then wins over these defaults). The "تماس با
# ما" page relays submitted tickets to this bot/chat instead of storing
# them in a table. Create a bot with @BotFather to get a token; the
# chat ID can be a user, group, or channel.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
