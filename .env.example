# Copy this file to .env and fill in real values before `docker compose up`.
APP_PORT=8080

# --- Shared database (must match the connected backend's own DB config) ---
# The Docker network name the backend platform's own docker-compose.yml
# created (find it with `docker network ls` if you're not sure).
BACKEND_NETWORK=change_me
# The container/hostname MySQL is reachable at on that network.
BACKEND_DB_HOST=change_me
BACKEND_DB_PORT=3306
BACKEND_DB_NAME=change_me
BACKEND_DB_USER=change_me
BACKEND_DB_PASS=change_me

# --- Sending ---
# Base URL of the backend's own REST API. ELLSMS POSTs to
# {API_BASE_URL}/api/messages/send to actually send a message. Can also
# be set later from Settings in the panel (stored in ellsms_settings,
# which then wins over this default).
API_BASE_URL=
