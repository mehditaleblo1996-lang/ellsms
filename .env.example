# Copy this file to .env and fill in real values before `docker compose up`.
APP_PORT=8080

# --- Shared database (must match the connected backend's own DB config) ---
# The Docker network name the backend platform's own docker-compose.yml
# created (find it with `docker network ls` if you're not sure).
BACKEND_NETWORK=change_me
# The container/hostname MySQL is reachable at on that network.
BACKEND_DB_HOST=change_me
BACKEND_DB_PORT=3306
BACKEND_DB_NAME=change_me
BACKEND_DB_USER=change_me
BACKEND_DB_PASS=change_me

# --- Sending ---
# Base URL of the backend's own REST API. ELLSMS POSTs to
# {API_BASE_URL}/api/messages/send to actually send a message. Can also
# be set later from Settings in the panel (stored in ellsms_settings,
# which then wins over this default).
API_BASE_URL=

# --- Payments (ZarinPal) ---
# Can also be set later from Settings in the panel (stored in
# ellsms_settings, which then wins over these defaults).
# Get your Merchant ID from https://next.zarinpal.com after registering.
ZARINPAL_MERCHANT_ID=
# Must match what ZarinPal calls back to after a payment attempt. Leave
# blank to auto-derive from the current request host — fine for testing,
# but ZarinPal merchant accounts are typically tied to a specific
# registered domain, so set this explicitly for production.
ZARINPAL_CALLBACK_URL=https://your-domain/zarinpal-callback.php
# Set to 1 to use ZarinPal's sandbox (test) environment — no real money
# moves, useful before your merchant account is fully approved.
ZARINPAL_SANDBOX=0

# --- Contact form (Telegram) ---
# Can also be set later from Settings in the panel (stored in
# ellsms_settings, which then wins over these defaults). The "تماس با
# ما" page relays submitted tickets to this bot/chat instead of storing
# them in a table. Create a bot with @BotFather to get a token; the
# chat ID can be a user, group, or channel.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
